import random
import time

# ------------------------------
# GAME SETUP
# ------------------------------

class Player:
    def __init__(self, name):
        self.name = name
        self.hp = 3
        self.items = []

    def is_alive(self):
        return self.hp > 0

def load_chambers():
    # Randomly load 1–3 live rounds and 1–3 blanks
    live = random.randint(1, 3)
    blanks = random.randint(1, 3)
    chambers = ["LIVE"] * live + ["BLANK"] * blanks
    random.shuffle(chambers)
    return chambers

def draw_items():
    item_pool = ["Cigarette", "Magnifying Glass", "Handcuffs", "Adrenaline"]
    return random.sample(item_pool, 2)

def print_status(player, dealer):
    print(f"\n{player.name} HP: {player.hp} | Dealer HP: {dealer.hp}")
    print(f"Your items: {player.items}")

# ------------------------------
# ITEM EFFECTS
# ------------------------------

def use_item(item, chambers, player, dealer):
    if item == "Cigarette":
        player.hp += 1
        print("You smoke a cigarette and recover 1 HP.")

    elif item == "Magnifying Glass":
        print("You inspect the next chamber...")
        print(f"The next round is: {chambers[0]}")

    elif item == "Handcuffs":
        print("You handcuff the dealer. They skip their next turn.")
        return "SKIP_DEALER"

    elif item == "Adrenaline":
        print("You gain an extra turn!")
        return "EXTRA_TURN"

    return None

# ------------------------------
# MAIN GAME LOOP
# ------------------------------

def buckshot_roulette():
    print("\n=== BUCKSHOT ROULETTE (Safe Python Version) ===\n")

    player = Player("You")
    dealer = Player("Dealer")

    while player.is_alive() and dealer.is_alive():
        chambers = load_chambers()
        player.items = draw_items()
        dealer.items = draw_items()

        print("\nA new round begins.")
        print_status(player, dealer)

        turn = "PLAYER"
        dealer_skip = False

        while chambers and player.is_alive() and dealer.is_alive():
            print("\n----------------------------------")
            print(f"Chambers remaining: {len(chambers)}")

            if turn == "PLAYER":
                print("\nYour turn.")
                print("1. Shoot Dealer")
                print("2. Shoot Yourself")
                print("3. Use Item")

                choice = input("> ")

                if choice == "1":
                    round_type = chambers.pop(0)
                    print("You pull the trigger at the dealer...")
                    time.sleep(1)

                    if round_type == "LIVE":
                        dealer.hp -= 1
                        print("LIVE ROUND! Dealer takes 1 damage.")
                    else:
                        print("BLANK! Dealer is unharmed.")

                    turn = "DEALER"

                elif choice == "2":
                    round_type = chambers.pop(0)
                    print("You pull the trigger at yourself...")
                    time.sleep(1)

                    if round_type == "LIVE":
                        player.hp -= 1
                        print("LIVE ROUND! You take 1 damage.")
                    else:
                        print("BLANK! You are unharmed.")

                    turn = "DEALER"

                elif choice == "3":
                    print("Choose an item:")
                    for i, item in enumerate(player.items):
                        print(f"{i+1}. {item}")

                    item_choice = int(input("> ")) - 1
                    item = player.items.pop(item_choice)

                    effect = use_item(item, chambers, player, dealer)
                    if effect == "EXTRA_TURN":
                        turn = "PLAYER"
                    elif effect == "SKIP_DEALER":
                        dealer_skip = True
                        turn = "PLAYER"
                    else:
                        turn = "DEALER"

            else:  # DEALER TURN
                if dealer_skip:
                    print("\nDealer is handcuffed and misses their turn.")
                    dealer_skip = False
                    turn = "PLAYER"
                    continue

                print("\nDealer's turn...")
                time.sleep(1)

                # Dealer AI: 70% chance to shoot player if chamber unknown
                if random.random() < 0.7:
                    target = "PLAYER"
                else:
                    target = "SELF"

                round_type = chambers.pop(0)

                if target == "PLAYER":
                    print("Dealer shoots at you...")
                    if round_type == "LIVE":
                        player.hp -= 1
                        print("LIVE ROUND! You take 1 damage.")
                    else:
                        print("BLANK! You are unharmed.")
                else:
                    print("Dealer shoots themselves...")
                    if round_type == "LIVE":
                        dealer.hp -= 1
                        print("LIVE ROUND! Dealer takes 1 damage.")
                    else:
                        print("BLANK! Dealer is unharmed.")

                turn = "PLAYER"

        print_status(player, dealer)

    # END OF GAME
    if player.is_alive():
        print("\n*** YOU WIN ***")
    else:
        print("\n*** DEALER WINS ***")

# ------------------------------
# START GAME
# ------------------------------

buckshot_roulette()
